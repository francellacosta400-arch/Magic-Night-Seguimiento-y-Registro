{
  // Debe llamarse igual que tu proyecto en Cloudflare.
  "name": "seguimiento-magic-nigth-producci-n",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    // La página (index.html) está en la misma carpeta. El archivo .assetsignore
    // evita que worker.js, wrangler.jsonc y los demás se publiquen como si fueran parte de la web.
    "directory": "./",
    "binding": "ASSETS",
    // Las rutas /api/* pasan primero por el código; el resto sale directo como archivo.
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "magic-night-hojas",
      "database_id": "23e8ecca-d82b-4d47-ae32-c45f32ac9a59"
    }
  ]
}
